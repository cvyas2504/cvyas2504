<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrontOfficeApp.Views.ExcelComparePage"
             Title="Excel Compare">
    <Grid Padding="16" RowDefinitions="Auto,*,Auto">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="8">
            <Entry Grid.Row="0" Placeholder="Reference file" Text="{Binding ReferenceFile}" />
            <Button Grid.Row="0" Grid.Column="1" Text="Upload" Command="{Binding PickReferenceCommand}" />
            <Entry Grid.Row="1" Placeholder="Data file" Text="{Binding DataFile}" />
            <Button Grid.Row="1" Grid.Column="1" Text="Upload" Command="{Binding PickDataCommand}" />
            <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="10">
                <Entry Placeholder="Match Column (1-based)" Keyboard="Numeric" Text="{Binding SelectedColumn}" WidthRequest="160" />
                <Button Text="Start Comparison" Command="{Binding CompareCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" />
            </HorizontalStackLayout>
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Results}" Margin="0,16,0,16">
            <CollectionView.Header>
                <Grid ColumnDefinitions="*,*,Auto,*"><Label Text="Reference"/><Label Grid.Column="1" Text="Data"/><Label Grid.Column="2" Text="Status"/><Label Grid.Column="3" Text="Remarks"/></Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,*,Auto,*" Padding="0,6">
                        <Label Text="{Binding ReferenceValue}" />
                        <Label Grid.Column="1" Text="{Binding DataValue}" />
                        <Label Grid.Column="2" Text="{Binding MatchStatus}" />
                        <Label Grid.Column="3" Text="{Binding Remarks}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Frame Grid.Row="2" IsVisible="{Binding ShowSummary}" BorderColor="#94A3B8">
            <VerticalStackLayout>
                <Label Text="Comparison Summary" FontAttributes="Bold" FontSize="18" />
                <Label Text="{Binding SummaryText}" />
                <HorizontalStackLayout>
                    <Button Text="View Detailed Report" />
                    <Button Text="Export Excel" Command="{Binding ExportExcelCommand}" />
                    <Button Text="Export PDF" Command="{Binding ExportPdfCommand}" />
                    <Button Text="Close" Command="{Binding CompareCommand}" IsVisible="False" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
