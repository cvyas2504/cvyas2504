<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrontOfficeApp.Views.EmployeesPage"
             Title="Employees">
    <Grid Padding="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <HorizontalStackLayout>
            <Entry Placeholder="Search employee" WidthRequest="260" Text="{Binding SearchText}" />
            <Button Text="Search" Command="{Binding LoadCommand}" />
        </HorizontalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
            <Entry Placeholder="Name" Text="{Binding SelectedEmployee.EmployeeName}" />
            <Entry Grid.Column="1" Placeholder="Department" Text="{Binding SelectedEmployee.Department}" />
            <Entry Grid.Column="2" Placeholder="Designation" Text="{Binding SelectedEmployee.Designation}" />
            <Entry Grid.Column="3" Placeholder="Phone" Text="{Binding SelectedEmployee.Phone}" />
            <Entry Grid.Column="4" Placeholder="Email" Text="{Binding SelectedEmployee.Email}" />
            <Button Grid.Column="5" Text="Add/Update" IsVisible="{Binding CanCreate}" Command="{Binding SaveCommand}" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Employees}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="70,*,*,*,*,Auto" Padding="0,6">
                        <Label Text="{Binding EmployeeID}" />
                        <Label Grid.Column="1" Text="{Binding EmployeeName}" />
                        <Label Grid.Column="2" Text="{Binding Department}" />
                        <Label Grid.Column="3" Text="{Binding Designation}" />
                        <Label Grid.Column="4" Text="{Binding Email}" />
                        <Button Grid.Column="5" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanDelete}" Text="Delete" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="3" Style="{StaticResource FooterLabelStyle}" />
    </Grid>
</ContentPage>
