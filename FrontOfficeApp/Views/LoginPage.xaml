<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrontOfficeApp.Views.LoginPage"
             Title="Login"
             BackgroundColor="{StaticResource Surface}">
    <VerticalStackLayout Padding="40" Spacing="12" VerticalOptions="Center" MaximumWidthRequest="420">
        <Label Text="Front Office Management" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
        <Entry Placeholder="Username" Text="{Binding Username}" />
        <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />
        <Button Text="Login" Command="{Binding LoginCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" />
        <Label Text="{Binding ErrorMessage}" TextColor="Red" />
    </VerticalStackLayout>
</ContentPage>
