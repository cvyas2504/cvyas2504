<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrontOfficeApp.Views.DashboardPage"
             Title="Dashboard">
    <Grid RowDefinitions="*,Auto" BackgroundColor="#F1F5F9">
        <Grid Grid.Row="0" ColumnDefinitions="220,*">
            <VerticalStackLayout Grid.Column="0" Padding="20" BackgroundColor="#0F172A" Spacing="10">
                <Label Text="Front Office ERP" FontSize="24" FontAttributes="Bold" TextColor="White" />
                <Button Text="Dashboard" Command="{Binding LoadCommand}" />
                <Button Text="Excel Compare" IsVisible="{Binding CanViewExcel}" Command="{Binding NavigateCommand}" CommandParameter="excel" />
                <Button Text="Employees" IsVisible="{Binding CanViewEmployees}" Command="{Binding NavigateCommand}" CommandParameter="employees" />
                <Button Text="Duty Roster" IsVisible="{Binding CanViewRoster}" Command="{Binding NavigateCommand}" CommandParameter="roster" />
                <Button Text="Reports" IsVisible="{Binding CanViewReports}" Command="{Binding NavigateCommand}" CommandParameter="reports" />
                <Button Text="Settings" Command="{Binding NavigateCommand}" CommandParameter="settings" />
                <Button Text="Logout" Command="{Binding LogoutCommand}" />
            </VerticalStackLayout>

            <ScrollView Grid.Column="1">
                <Grid Padding="20" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                    <Frame Grid.Row="0" Grid.Column="0"><VerticalStackLayout><Label Text="Total Employees"/><Label Text="{Binding TotalEmployees}" FontSize="28" FontAttributes="Bold"/></VerticalStackLayout></Frame>
                    <Frame Grid.Row="0" Grid.Column="1"><VerticalStackLayout><Label Text="Morning Shift"/><Label Text="{Binding MorningShiftCount}" FontSize="28" FontAttributes="Bold"/></VerticalStackLayout></Frame>
                    <Frame Grid.Row="1" Grid.Column="0"><VerticalStackLayout><Label Text="Evening Shift"/><Label Text="{Binding EveningShiftCount}" FontSize="28" FontAttributes="Bold"/></VerticalStackLayout></Frame>
                    <Frame Grid.Row="1" Grid.Column="1"><VerticalStackLayout><Label Text="Night Shift"/><Label Text="{Binding NightShiftCount}" FontSize="28" FontAttributes="Bold"/></VerticalStackLayout></Frame>
                    <Frame Grid.Row="2" Grid.ColumnSpan="2"><VerticalStackLayout><Label Text="Off Count"/><Label Text="{Binding OffCount}" FontSize="28" FontAttributes="Bold"/></VerticalStackLayout></Frame>
                </Grid>
            </ScrollView>
        </Grid>

        <Label Grid.Row="1" Style="{StaticResource FooterLabelStyle}" />
    </Grid>
</ContentPage>
