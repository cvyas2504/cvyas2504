<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrontOfficeApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#2563EB</Color>
            <Color x:Key="Surface">#F8FAFC</Color>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="#0F172A"/>
            </Style>
            <Style x:Key="FooterLabelStyle" TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Margin" Value="0,8,0,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="#64748B" />
                <Setter Property="Text" Value="Developed by Chetan" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
